{{- $pages := first site.Config.Services.RSS.Limit (where site.RegularPages "Section" "news") -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.Language.Locale }}">
  <title>{{ site.Title }}</title>
  <subtitle>{{ site.Params.description }}</subtitle>
  <link rel="alternate" type="text/html" href="{{ .Permalink }}"/>
  {{- with .OutputFormats.Get "atom" }}
  <link rel="self" type="{{ .MediaType.Type }}" href="{{ .Permalink }}"/>
  {{- end }}
  <id>{{ .Permalink }}</id>
  {{- with $pages }}
  <updated>{{ (index . 0).Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</updated>
  {{- end }}
  {{- range $pages }}
  <entry>
    <title>{{ .Title }}</title>
    <link rel="alternate" type="text/html" href="{{ .Permalink }}"/>
    <id>{{ or .Params.guid .Permalink }}</id>
    <published>{{ .Date.Format "2006-01-02T15:04:05Z07:00" }}</published>
    <updated>{{ .Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</updated>
    {{- range .GetTerms "authors" }}
    <author><name>{{ .LinkTitle }}</name></author>
    {{- end }}
    {{- range .GetTerms "categories" }}
    <category term="{{ .LinkTitle }}"/>
    {{- end }}
    <summary>{{ .Summary | plainify | htmlUnescape | truncate 300 | string }}</summary>
    <content type="html">{{ string .Content }}</content>
  </entry>
  {{- end }}
</feed>
